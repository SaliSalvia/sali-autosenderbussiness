<?xml version="1.0" encoding="utf-8"?>
<!--
  Defense in depth for Android 12+ (API 31+). allowBackup is already false, but
  an OEM / future override must still never copy the Room database, logs,
  campaign draft or encrypted preferences into a cloud backup or device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
